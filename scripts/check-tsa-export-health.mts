  async function downloaded(i: number, format: string) { for (let n = 0; n < 200; n++) { if (downloads[i] && completedDownloads.has(downloads[i].guid)) { const name = `aivra-tsa-summary-v1.${format}`; assert.equal(downloads[i].suggestedFilename, name); const content = await readFile(path.join(directory, name), "utf8"), blob = await evaluate(`(async()=>{const b=window.__tsaBlobs[${i}];return {text:await b.text(),type:b.type}})()`); assert.equal(blob.text, content); assert.equal(blob.type, format === "csv" ? "text/csv;charset=utf-8" : "application/json;charset=utf-8"); assert.ok(new TextEncoder().encode(content).length <= MAX_TSA_EXPORT_BYTES); return content; } await new Promise((r) => setTimeout(r, 50)); } throw Error("TSA download timeout"); }
