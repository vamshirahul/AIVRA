# U00.07 remains offline-only. No credentials are needed for tests or build.
# AIVRA_AI_ENABLED=true still cannot remove the two existing live hard stops.
# Live activation also requires approved models/rates, a durable atomic executor,
# operator limits, a trusted anonymous edge, credentials and deployment approval.
AIVRA_AI_ENABLED=
OPENAI_API_KEY=
AIVRA_PAID_MODEL_ID=

# Reserved independent fallback/identity names for a later approved live binding.
# The offline router does not load these or choose a provider from environment.
AIVRA_FALLBACK_API_KEY=
AIVRA_FALLBACK_MODEL_ID=
AIVRA_FALLBACK_PROVIDER=
AIVRA_FALLBACK_BASE_URL=
AIVRA_ANON_HASH_SECRET=

# LOCAL ALA ONLY: use npm run dev:local-ala (binds 127.0.0.1:3000).
# Keep all flags off/blank until private local operator configuration is complete.
AIVRA_LOCAL_DEMO_ONLY=
# Default paid on only INSIDE the separately activated local mode; fallback OFF.
AIVRA_LOCAL_PAID_ENABLED=
AIVRA_LOCAL_FALLBACK_ENABLED=
# Explicit campaign exposure caps in USD, >0 and <=10 per enabled path.
AIVRA_LOCAL_PAID_BUDGET_USD=
AIVRA_LOCAL_FALLBACK_BUDGET_USD=
# Conservative positive integer micro-USD/token, operator-verified upward bounds.
AIVRA_LOCAL_PAID_INPUT_MICRO_USD=
AIVRA_LOCAL_PAID_OUTPUT_MICRO_USD=
AIVRA_LOCAL_FALLBACK_INPUT_MICRO_USD=
AIVRA_LOCAL_FALLBACK_OUTPUT_MICRO_USD=
# Optional bounded payload/output settings (defaults 128000 bytes / 2048 tokens).
AIVRA_LOCAL_MAX_INPUT_BYTES=
AIVRA_LOCAL_MAX_OUTPUT_TOKENS=
# Required only when genuine OpenRouter fallback is explicitly enabled.
AIVRA_LOCAL_OPEN_WEIGHT_APPROVED=
AIVRA_LOCAL_OPEN_WEIGHT_EVIDENCE=
AIVRA_LOCAL_OPENROUTER_UPSTREAM=

# Optional loopback port; default 3000. Must match the dedicated launcher.
AIVRA_LOCAL_PORT=
