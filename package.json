    "@ai-sdk/openai": "4.0.106",
    "ai": "7.0.159",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
