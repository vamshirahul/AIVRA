{
  "name": "aivra-public-preview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:fixture": "node scripts/validate-fixture.mts",
    "check:ai-adapter": "node --conditions=react-server scripts/check-ai-adapter.mts",
    "check:ai-controls": "node --conditions=react-server scripts/check-ai-controls.mts",
    "check:ai-ui": "node scripts/check-ai-ui.mts",
    "check:data-mapper": "node scripts/check-data-mapper-preview.mts",
    "check:csv-preview": "node scripts/check-csv-preview.mts",
    "check:column-mapping": "node scripts/check-column-mapping.mts",
    "check:ci": "npm run validate:fixture && node scripts/check-demo-session.mts && npm run check:ai-adapter && npm run check:ai-controls && npm run check:ai-ui && npm run check:data-mapper && npm run check:csv-preview && npm run check:column-mapping && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@ai-sdk/openai": "4.0.106",
    "ai": "7.0.159",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
